rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Catch-all deny
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. Reusable Helpers
    function isSignedIn() { return request.auth != null; }
    function isEmailVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function getUserData() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function hasRole(role) { return isSignedIn() && getUserData().role == role; }
    function isAdmin() { return hasRole('admin'); }
    function isManager() { return hasRole('manager'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // 2. Entity Validations
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
             data.uid == request.auth.uid &&
             data.role in ['admin', 'staff', 'manager', 'clerk'] &&
             data.email is string && data.email.size() < 256;
    }

    function isValidMedicine(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() < 200 &&
             data.stockQuantity is number && data.stockQuantity >= 0 &&
             data.expiryDate is string && data.expiryDate.size() == 10;
    }

    // 3. Match Blocks
    
    // Users Collection
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if (isOwner(userId) || isAdmin());
    }

    // Inventory
    match /inventory/{medicineId} {
      allow read: if isSignedIn();
      allow create: if (isAdmin() || isManager()) && isValidMedicine(incoming());
      allow update: if isSignedIn() && isValidMedicine(incoming()); // Staff can update stock
      allow delete: if isAdmin();
    }

    // Sales
    match /sales/{saleId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && incoming().staffId == request.auth.uid;
      // Sales are immutable
    }

    // Wholesalers
    match /wholesalers/{wholesalerId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isManager();
    }

    // Bills
    match /bills/{billId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() || isManager();
    }

    // Activity & Audit Logs
    match /activity_logs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /stock_movements/{movementId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }
  }
}
